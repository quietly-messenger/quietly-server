# Server listen address (HOST:PORT).
SERVER_ADDR=0.0.0.0:8080

# PostgreSQL connection string. In docker-compose the host is `postgres`.
# Use sslmode=require (or stronger) whenever Postgres is not on localhost: the
# connection carries auth headers, prekeys, and ciphertext (§1).
DATABASE_URL=postgresql://quietly:quietly@postgres:5432/quietly?sslmode=disable

LOG_LEVEL=info
MESSAGE_TTL_DAYS=30
POW_DIFFICULTY=18

# TLS 1.3 (PROTOCOL.md §1 requires HTTPS on every client connection). Set both
# files to terminate TLS in-process, or leave them unset and run the server
# behind a TLS terminator (Caddy/nginx). Certificate files must be readable by
# the process.
#TLS_CERT_FILE=/etc/quietly/tls/fullchain.pem
#TLS_KEY_FILE=/etc/quietly/tls/privkey.pem

# Optional PROTOCOL.md §15 limits (defaults shown).
#AUTH_SKEW_MS=60000
#POW_WINDOW_MS=300000
#MAX_DEVICES_PER_ACCOUNT=5
#OTP_BATCH_SIZE=100
#OTP_REPLENISH_THRESHOLD=20
#OTP_MAX_STORED=200
#SEALED_BLOB_MAX=65536
#FETCH_LIMIT_MAX=500
#SPK_ROTATION_DAYS=3
#SPK_GRACE_DAYS=3
#DELIVERY_TOKEN_BYTES=32
# Per-requesting-device bundle fetch rate (§7.2.1 mitigation 1).
#BUNDLE_FETCH_PER_HOUR=60
# Per-IP request rate for the whole HTTP surface.
#REQUESTS_PER_MINUTE=120
# WebSocket lifecycle (§13).
#WS_PING_INTERVAL_S=30
#WS_IDLE_TIMEOUT_S=90
# Comma-separated browser origins allowed to open /v1/ws. Native clients send
# no Origin header and are unaffected. Empty = browsers refused.
#WS_ALLOWED_ORIGINS=

# Trust service Ed25519 private key (base64url, 64 bytes). Leave empty to
# generate an ephemeral key for local development.
#TRUST_PRIVATE_KEY=
# Trust service public key (base64url, 32 bytes), used by the gateway to verify.
#TRUST_PUBLIC_KEY=
# Admin bearer token required by POST /servers and /servers/{domain}/revoke on
# the trust service. The service refuses to start without it.
#TRUST_ADMIN_TOKEN=change-me
# Where the trust service persists issued certificates and revocations.
#TRUST_STATE_PATH=trust-state.json
# Base URL of the trust service, polled by the gateway for live revocation.
#TRUST_URL=http://trust:8081
